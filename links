      <nav class="links" aria-label="Links de contato">

        <!-- SITE OFICIAL -->
        <a class="tile feature reveal" id="site" href="#">
          <span class="tile-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
              <circle cx="12" cy="12" r="9"/>
              <path d="M3 12h18M12 3c6 6 6 12 0 18M12 3c-6 6-6 12 0 18"/>
            </svg>
          </span>

          <span class="tile-copy">
            <strong>Conheça nosso site</strong>
            <small>Produtos, soluções e nossa estrutura</small>
          </span>

          <span class="arrow">
            <svg fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
              <path d="M5 19 19 5M7 5h12v12"/>
            </svg>
          </span>
        </a>

        <!-- COMERCIAL MATTHEUS -->
        <a
          class="tile reveal"
          href="https://wa.me/554235224313?text=Ol%C3%A1%2C%20Mattheus!%20Vim%20pelo%20link%20da%20SLB%20e%20gostaria%20de%20atendimento%20comercial."
          target="_blank"
