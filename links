
<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#090909">
  <meta name="description" content="SLB Hidromecânica — links oficiais e atendimento.">

  <title>SLB Hidromecânica | Links Oficiais</title>

  <link rel="icon" href="https://cdn.shopify.com/s/files/1/0993/5788/4732/files/WhatsApp_Image_2026-10-15_at_22.56.22.jpg?v=1792117328">

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Montserrat:wght@500;600;700;800;900&display=swap" rel="stylesheet">

  <style>
    :root {
      --yellow: #ffb800;
      --black: #090909;
      --panel: #161616;
      --line: #343434;
      --white: #f5f5f6;
      --muted: #a3a3a3;
    }

    * { box-sizing: border-box; }

    html { scroll-behavior: smooth; }

    body {
      margin: 0;
      background: var(--black);
      color: var(--white);
      font-family: 'DM Sans', sans-serif;
      -webkit-font-smoothing: antialiased;
      overflow-x: hidden;
    }

    a {
      color: inherit;
      text-decoration: none;
    }

    .noise {
      position: fixed;
      inset: 0;
      pointer-events: none;
      z-index: 10;
      opacity: .16;
      background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 180 180' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.75' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.14'/%3E%3C/svg%3E");
    }

    .gridbg {
      position: absolute;
      inset: 0;
      pointer-events: none;
      background-image:
        linear-gradient(#ffffff06 1px, transparent 1px),
        linear-gradient(90deg, #ffffff06 1px, transparent 1px);
      background-size: 54px 54px;
      mask-image: linear-gradient(to bottom, #000, transparent 89%);
    }

    .wrap {
      position: relative;
      isolation: isolate;
      max-width: 560px;
      margin: auto;
      min-height: 100svh;
      padding: 32px 23px 23px;
    }

    .topline {
      display: flex;
      align-items: center;
      justify-content: space-between;
      font: 700 10px Montserrat, sans-serif;
      letter-spacing: .19em;
      color: #8b8b8b;
    }

    .topline span:last-child {
      color: var(--yellow);
    }

    .hero {
      padding-top: 49px;
      text-align: center;
      position: relative;
    }

    .halo {
      position: absolute;
      width: 320px;
      height: 320px;
      border-radius: 50%;
      background: radial-gradient(circle, #ffb80026, transparent 70%);
      left: 50%;
      top: 20px;
      transform: translateX(-50%);
      z-index: -1;
      pointer-events: none;
    }

    .logo-shell {
      width: 184px;
      padding: 12px;
      background: #fff;
      border-radius: 21px;
      display: grid;
      place-items: center;
      margin: 0 auto 30px;
      box-shadow: 0 0 0 1px #ffffff30, 0 0 65px #ffb80012;
      animation: heroPop .8s cubic-bezier(.2,.8,.2,1) both;
    }

    .logo-shell img {
      display: block;
      width: 100%;
      height: auto;
      mix-blend-mode: multiply;
    }

    .eyebrow {
      display: flex;
      align-items: center;
      justify-content: center;
      color: var(--yellow);
      letter-spacing: .22em;
      text-transform: uppercase;
      font: 800 10px Montserrat, sans-serif;
      margin: 0 0 14px;
    }

    h1 {
      font: 900 clamp(30px,7.8vw,42px)/1.1 Montserrat, sans-serif;
      letter-spacing: -.047em;
      margin: 0 0 17px;
      text-transform: uppercase;
    }

    h1 em {
      font-style: normal;
      color: var(--yellow);
    }

    .lead {
      color: #bcbcbc;
      max-width: 380px;
      margin: 0 auto;
      line-height: 1.65;
      font-size: 14px;
    }

    .divider {
      display: flex;
      align-items: center;
      gap: 14px;
      margin: 42px 0 17px;
      text-transform: uppercase;
      letter-spacing: .18em;
      font: 800 10px Montserrat, sans-serif;
      color: #969696;
    }

    .divider::after {
      content: '';
      height: 1px;
      background: #303030;
      flex: 1;
    }

    .links {
      display: grid;
      gap: 13px;
    }

    .tile {
      display: flex;
      align-items: center;
      gap: 16px;
      position: relative;
      min-height: 96px;
      padding: 18px 18px 18px 19px;
      border: 1px solid #363636;
      background: linear-gradient(120deg, #1b1b1b, #111);
      border-radius: 14px;
      overflow: hidden;
      transition:
        border-color .28s,
        transform .28s,
        box-shadow .28s;
    }

    .tile::before {
      position: absolute;
      content: '';
      inset: 0;
      background: linear-gradient(100deg, #ffb80012, transparent 65%);
      opacity: 0;
      transition: opacity .3s;
    }

    .tile:hover {
      border-color: #ffb800a6;
      transform: translateY(-3px);
      box-shadow: 0 14px 36px #0008;
    }

    .tile:hover::before {
      opacity: 1;
    }

    .tile.feature {
      border-color: var(--yellow);
      background: var(--yellow);
      color: #0a0a0a;
      box-shadow: 0 8px 30px #ffb80019;
    }

    .tile.feature:hover {
      background: #ffc629;
    }

    .tile.feature::before {
      display: none;
    }

    .tile-icon {
      width: 47px;
      height: 47px;
      display: grid;
      place-items: center;
      flex: 0 0 auto;
      background: #292929;
      border: 1px solid #414141;
      border-radius: 12px;
      color: var(--yellow);
    }

    .feature .tile-icon {
      background: #0b0b0b;
      border-color: #0b0b0b;
    }

    .tile-icon svg {
      width: 23px;
      height: 23px;
    }

    .tile-copy {
      flex: 1;
      min-width: 0;
      position: relative;
    }

    .tile-copy strong {
      display: block;
      font: 800 14px/1.35 Montserrat, sans-serif;
      letter-spacing: -.02em;
    }

    .tile-copy small {
      display: block;
      color: #999;
      font-size: 11.5px;
      margin-top: 6px;
      line-height: 1.4;
    }

    .feature .tile-copy small {
      color: #4e3c00;
    }

    .arrow {
      width: 25px;
      height: 25px;
      flex: none;
      transition: transform .25s;
    }

    .arrow svg {
      width: 100%;
      height: 100%;
    }

    .tile:hover .arrow {
      transform: translate(3px,-3px);
    }

    .note {
      text-align: center;
      display: flex;
      gap: 8px;
      align-items: center;
      justify-content: center;
      font-size: 11px;
      color: #858585;
      margin-top: 24px;
    }

    .note b {
      width: 6px;
      height: 6px;
      background: var(--yellow);
      border-radius: 50%;
      box-shadow: 0 0 10px #ffb80090;
    }

    .signature {
      margin-top: 59px;
      border-top: 1px solid #303030;
      padding-top: 22px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 10px;
      color: #737373;
      font-size: 10px;
    }

    .signature strong {
      font: 800 12px Montserrat, sans-serif;
      color: #dadada;
      letter-spacing: .04em;
    }

    .signature strong span {
      color: var(--yellow);
    }

    .bottomstripe {
      height: 4px;
      background: linear-gradient(90deg, transparent, #ffb800, transparent);
      margin-top: 19px;
      border-radius: 50%;
    }

    .reveal {
      opacity: 0;
      transform: translateY(26px);
      transition:
        opacity .7s ease,
        transform .7s cubic-bezier(.2,.8,.2,1);
    }

    .reveal.visible {
      opacity: 1;
      transform: translateY(0);
    }

    .links .tile:nth-child(2) {
      transition-delay: 85ms;
    }

    .links .tile:nth-child(3) {
      transition-delay: 170ms;
    }

    @keyframes heroPop {
      from {
        opacity: 0;
        transform: translateY(20px) scale(.92);
      }
      to {
        opacity: 1;
        transform: translateY(0) scale(1);
      }
    }

    @media (min-width: 700px) {
      .wrap {
        padding-top: 42px;
        padding-bottom: 40px;
      }

      .hero { padding-top: 58px; }
      .logo-shell { width: 205px; }
      .tile { min-height: 104px; }
      .tile-copy strong { font-size: 15px; }
    }

    @media (prefers-reduced-motion: reduce) {
      html { scroll-behavior: auto; }

      .reveal {
        opacity: 1;
        transform: none;
        transition: none;
      }

      .logo-shell { animation: none; }
      .tile { transition: none; }
    }
  </style>
</head>

<body>

  <div class="noise"></div>

  <div class="wrap">
    <div class="gridbg"></div>

    <header class="topline">
      <span>SLB / HIDROMECÂNICA</span>
      <span>LINKS OFICIAIS ↗</span>
    </header>

    <main>
      <section class="hero">
        <div class="halo"></div>

        <div class="logo-shell">
          <img
            src="https://plain-enam-prod-public.komododecks.com/202610/16/5PsO4IytZYm0rCwXx6sB/image.jpg"
            alt="SLB Hidromecânica"
