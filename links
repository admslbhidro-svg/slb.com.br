        >
          <span class="tile-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
              <path d="M20.5 11.5a8.5 8.5 0 0 1-12.4 7.5L3 20l1.1-5A8.5 8.5 0 1 1 20.5 11.5Z"/>
              <path d="M8.4 8.3c.2 2.7 3.5 6.1 6.6 6.9.5.1 1.4-1.1 1.2-1.6l-2.3-1.1-1 1c-1.5-.6-2.7-1.8-3.4-3.3l.9-1.1-1-2c-.2-.4-1-.1-1 .2Z"/>
            </svg>
          </span>

          <span class="tile-copy">
            <strong>Comercial · Mattheus</strong>
            <small>Orçamentos e vendas • (42) 3522-4313</small>
          </span>

          <span class="arrow">
            <svg fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
              <path d="M5 19 19 5M7 5h12v12"/>
            </svg>
          </span>
        </a>

        <!-- FINANCEIRO JOSIANE -->
        <a
          class="tile reveal"
          href="https://wa.me/5542933001910?text=Ol%C3%A1%2C%20Josiane!%20Vim%20pelo%20link%20da%20SLB%20e%20gostaria%20de%20falar%20sobre%20faturamento%20ou%20financeiro."
          target="_blank"
          rel="noopener noreferrer"
        >
          <span class="tile-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
              <rect x="5" y="2.8" width="14" height="18.4" rx="2"/>
              <path d="M8 7h8M8.5 11h1M12 11h1M15.5 11h.1M8.5 14.5h1M12 14.5h1M15.5 14.5h.1M8.5 18h1M12 18h4"/>
            </svg>
          </span>

          <span class="tile-copy">
            <strong>Financeiro · Josiane</strong>
            <small>Faturamento e financeiro • (42) 93300-1910</small>
          </span>

          <span class="arrow">
            <svg fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
              <path d="M5 19 19 5M7 5h12v12"/>
